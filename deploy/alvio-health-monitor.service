[Unit]
Description=Alvio Operational Health, Disk, Backup & 503-Rate Monitor

[Service]
Type=oneshot
User=alvio
Group=alvio
WorkingDirectory=/opt/alvio
EnvironmentFile=/etc/alvio/api.env
Environment=ALVIO_API_URL=http://127.0.0.1:3001
Environment=CHECK_BACKUP_DIR=/var/backups/alvio
Environment=CHECK_JOURNAL_503=true
ExecStart=/opt/alvio/deploy/health-monitor.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alvio-health-monitor
