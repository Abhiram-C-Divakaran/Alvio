[Unit]
Description=Alvio SQLite WAL-safe Online Backup & Integrity Verification

[Service]
Type=oneshot
User=alvio
Group=alvio
WorkingDirectory=/opt/alvio
EnvironmentFile=/etc/alvio/api.env
ExecStart=/opt/alvio/deploy/run-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alvio /var/backups/alvio
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alvio-backup
