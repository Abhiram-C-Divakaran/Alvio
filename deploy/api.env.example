# Alvio Express API Production / Staging Environment Template
# Copy to /etc/alvio/api.env on Host A (API + SQLite + Nginx) and lock permissions:
#   sudo chown root:alvio /etc/alvio/api.env && sudo chmod 640 /etc/alvio/api.env
# NEVER commit populated secrets to Git.

NODE_ENV=production
PORT=3001
DATABASE_PATH=/var/lib/alvio/database.sqlite

# Required: generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Required: exact HTTPS origin(s), comma-separated, NO trailing slash
ALLOWED_ORIGINS=https://staging.alvio.example.com
COOKIE_SECURE=true
TRUST_PROXY=true

# Single-host persistent rate limits ('sqlite') or multi-host ('redis' with REDIS_REST_URL + REDIS_REST_TOKEN)
RATE_LIMIT_STORE=sqlite
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Coding Judge Provider:
# Keep JUDGE_PROVIDER=paiza until your dedicated Linux judge host passes live gVisor (runsc) verification.
# Switch to JUDGE_PROVIDER=isolated ONLY after live verification passes on Host B.
JUDGE_PROVIDER=paiza
ISOLATED_JUDGE_URL=http://10.0.1.20:4005
ISOLATED_JUDGE_TOKEN=
JUDGE_CPU_LIMIT_SEC=5
JUDGE_MEMORY_LIMIT_MB=256
PAIZA_API_KEY=

# External AI Provider (server-only; omit to keep AI endpoints fail-closed with honest 503)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISUALIZER_MODEL=openai/gpt-oss-120b

# Transactional Email for Password Reset & Email Verification (omit for honest 503 EMAIL_NOT_CONFIGURED)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Optional Operational Hooks (backups & monitoring)
BACKUP_DIR=/var/backups/alvio
BACKUP_RETENTION_DAYS=14
BACKUP_S3_URI=
BACKUP_RCLONE_REMOTE=
ALERT_WEBHOOK_URL=
