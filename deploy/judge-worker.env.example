# Alvio Dedicated Isolated Judge Worker Environment Template
# Copy to /etc/alvio/judge-worker.env on Host B (Dedicated Private Linux Judge VM ONLY)
# Lock permissions:
#   sudo chmod 600 /etc/alvio/judge-worker.env
# NEVER place API JWT secrets, Groq keys, or database paths on the judge host.

NODE_ENV=production

# Bind strictly to Host B's private VPC/WireGuard IP (NEVER 0.0.0.0 on a public NIC)
JUDGE_WORKER_HOST=10.0.1.20
JUDGE_WORKER_PORT=4005

# Mandatory shared secret matching ISOLATED_JUDGE_TOKEN on Host A (>= 48 bytes hex recommended)
ISOLATED_JUDGE_TOKEN=

# Mandatory for untrusted public traffic: official Google gVisor runtime
JUDGE_DOCKER_RUNTIME=runsc

# Bounded concurrency admission control (excess jobs return HTTP 503 + Retry-After: 2)
JUDGE_MAX_CONCURRENT_JOBS=4
