# Required: supply a private random secret of at least 32 characters. No default.
JWT_SECRET=
# Optional: short-lived access JWT lifetime (default 15m) and rotating refresh session window in days (default 7).
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7
# Optional: set to true behind HTTPS in production; set TRUST_PROXY=true behind a reverse proxy.
COOKIE_SECURE=
TRUST_PROXY=
# Optional: 'memory' (default), 'sqlite' (single-host persistent), or 'redis' (multi-instance via REDIS_REST_URL).
RATE_LIMIT_STORE=memory
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Optional: 'paiza' (default) or 'isolated' (dedicated container/microVM judge worker via ISOLATED_JUDGE_URL).
JUDGE_PROVIDER=paiza
ISOLATED_JUDGE_URL=
ISOLATED_JUDGE_TOKEN=
JUDGE_CPU_LIMIT_SEC=5
JUDGE_MEMORY_LIMIT_MB=256
# Optional: standalone judge-worker/service settings (run on a dedicated Linux Docker/gVisor host).
JUDGE_WORKER_HOST=127.0.0.1
JUDGE_WORKER_PORT=4005
JUDGE_MAX_CONCURRENT_JOBS=4
JUDGE_DOCKER_RUNTIME=
# Optional: configure transactional email delivery for password reset & email verification.
# Either RESEND_API_KEY + EMAIL_FROM, or EMAIL_WEBHOOK_URL (+ optional EMAIL_WEBHOOK_SECRET).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
# Required in production; comma-separated exact origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3001
PORT=3001
DATABASE_PATH=./data/database.sqlite
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISUALIZER_MODEL=openai/gpt-oss-120b
NODE_ENV=development
